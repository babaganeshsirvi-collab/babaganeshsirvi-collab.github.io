{
  "name": "babas-bar-restro",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "preview": "npm run build && node scripts/preview.mjs",
    "deploy": "node scripts/check-deployment.mjs && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "admin:bootstrap": "node scripts/admin-credentials.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^30.1.1",
    "miniflare": "4.20260730.0",
    "wrangler": "4.151.0"
  },
  "dependencies": {
    "@noble/hashes": "2.0.1"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5",
      "undici": "7.29.1"
    }
  }
}
